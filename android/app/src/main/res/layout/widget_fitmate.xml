<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_workout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FitMate"
        android:textSize="11sp"
        android:textColor="#94B094"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:fontFamily="sans-serif-medium" />

    <TextView
        android:id="@+id/widget_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0 steps"
        android:textSize="22sp"
        android:textColor="#E8F5E0"
        android:fontFamily="sans-serif-black"
        android:layout_marginTop="2dp" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="6dp"
        android:progress="0"
        android:progressTint="#5AAD50"
        android:progressBackgroundTint="#2A3D2A" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_completion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0% done"
            android:textSize="11sp"
            android:textColor="#5AAD50"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/widget_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goal: 8000"
            android:textSize="11sp"
            android:textColor="#527A52" />
    </LinearLayout>
</LinearLayout>
